{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/training",
      "destination": "/training/index.html"
    },
    {
      "source": "/workout",
      "destination": "/workout/index.html"
    },
    {
      "source": "/aw26",
      "destination": "/aw26/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
